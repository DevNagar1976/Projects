{
  "name": "shopsphere-mern",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c cyan,orange \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "client": "npm run dev --workspace client",
    "server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm test --workspace server",
    "seed": "npm run seed --workspace server",
    "start": "npm start --workspace server"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "concurrently": "^9.1.2"
  }
}
